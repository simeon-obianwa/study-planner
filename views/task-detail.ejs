<%- include('partials/header') %>

    <section class="panel">
        <div class="detail-nav">
            <a href="/dashboard" class="btn-link">&larr; Back to Dashboard</a>
        </div>

        <% if (noticeMessage) { %>
            <div class="alert-success" role="status">
                <strong>Notification:</strong>
                <%= noticeMessage %>
            </div>
            <% } %>

                <% if (!task) { %>
                    <h1>Task Not Found</h1>
                    <p class="empty-state">The requested study task could not be found or no longer exists in this
                        session.</p>
                    <% } else { const overdue=task.status !==TaskStatus.COMPLETED && isOverdue(task.dueDate); %>
                        <div class="detail-header">
                            <div class="detail-badges">
                                <span class="badge task-id-badge">
                                    <%= task.taskCode || 'SP-000' %>
                                </span>
                                <span class="badge status-<%= task.status.toLowerCase() %>">
                                    <%= task.status.replace('_', ' ' ) %>
                                </span>
                                <span class="badge priority-<%= (task.priority || 'MEDIUM').toLowerCase() %>">
                                    <%= task.priority || 'MEDIUM' %>
                                </span>
                            </div>
                            <h1>
                                <%= task.title %>
                            </h1>
                        </div>

                        <dl class="detail-list">
                            <div class="detail-item">
                                <dt>Task ID</dt>
                                <dd><strong>
                                        <%= task.taskCode || 'SP-000' %>
                                    </strong></dd>
                            </div>

                            <div class="detail-item">
                                <dt>System UUID</dt>
                                <dd><code><%= task.id %></code></dd>
                            </div>

                            <div class="detail-item detail-item-full">
                                <dt>Description</dt>
                                <dd>
                                    <%= task.description %>
                                </dd>
                            </div>

                            <div class="detail-item">
                                <dt>Priority Level</dt>
                                <dd>
                                    <%= task.priority || 'MEDIUM' %>
                                </dd>
                            </div>

                            <div class="detail-item">
                                <dt>Due Date</dt>
                                <dd>
                                    <strong>
                                        <%= formatDate(task.dueDate) %>
                                    </strong>
                                    <% if (overdue) { %>
                                        <span class="overdue-tag">OVERDUE</span>
                                        <% } %>
                                </dd>
                            </div>

                            <div class="detail-item">
                                <dt>Task Owner Name</dt>
                                <dd>
                                    <%= task.ownerName || 'Unassigned' %>
                                </dd>
                            </div>

                            <div class="detail-item">
                                <dt>Task Owner Email</dt>
                                <dd>
                                    <%= task.ownerEmail || 'Not provided' %>
                                </dd>
                            </div>

                            <div class="detail-item">
                                <dt>Task Owner Mobile</dt>
                                <dd>
                                    <%= task.ownerPhone || 'Not provided' %>
                                </dd>
                            </div>
                        </dl>

                        <form action="/tasks/<%= task.id %>/status" method="POST" class="detail-status-form">
                            <input type="hidden" name="redirectTo" value="/tasks/<%= task.id %>">
                            <label for="detail-status">Update Task Status:</label>
                            <select id="detail-status" name="status">
                                <% Object.values(TaskStatus).forEach(status=> { %>
                                    <option value="<%= status %>" <%=task.status===status ? 'selected' : '' %>>
                                        <%= status.replace('_', ' ' ) %>
                                    </option>
                                    <% }) %>
                            </select>
                            <button type="submit" class="btn-primary">Save &amp; Notify Owner</button>
                        </form>
                        <% } %>
    </section>

    <% if (task) { %>
        <section class="panel">
            <h2>Status Notification History (<%= task.notifications ? task.notifications.length : 0 %>)</h2>
            <% if (!task.notifications || task.notifications.length===0) { %>
                <p class="empty-state">No status notifications have been dispatched for this task yet. Update the task
                    status above to trigger one.</p>
                <% } else { %>
                    <ul class="notification-log">
                        <% task.notifications.forEach(entry=> { %>
                            <li class="notification-item">
                                <span class="notification-time">
                                    <%= new Date(entry.sentAt).toLocaleString('en-GB', { dateStyle: 'medium' ,
                                        timeStyle: 'short' }) %>
                                </span>
                                <p>
                                    <%= entry.message %>
                                </p>
                            </li>
                            <% }) %>
                    </ul>
                    <% } %>
        </section>
        <% } %>

            <%- include('partials/footer') %>